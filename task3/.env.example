# Copy to .env and adjust values. This file is tracked; .env is gitignored.
# Used by docker-compose at the repo root.

# MySQL
MYSQL_ROOT_PASSWORD=rootpass
DB_NAME=curling_game
DB_USER=curling_user
DB_PASSWORD=curling_pass
DB_PORT=3306

# Server (host port mapping; container listens on 3001)
SERVER_PORT=3001

# Client (host port mapping; Vite dev server listens on 5173)
CLIENT_PORT=5173
